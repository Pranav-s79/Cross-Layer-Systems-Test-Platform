"""CrossLayer adapter for @@TITLE@@.

Generated by `crosslayer new adapter @@NAME@@`. It works out of the box on
examples/sample.log. Search for TODO to adapt it to your system.

collect() copies existing logs into the run bundle; normalize() turns each
line into a NormalizedEvent. To let CrossLayer launch the system as well,
implement build()/execute() and declare Capability.BUILD/EXECUTE.
"""

from __future__ import annotations

import re
import shutil
from pathlib import Path
from typing import Any, Sequence

from crosslayer.core.adapters import (
    AdapterDescription,
    Artifact,
    Capability,
    EventSpec,
    ExecutionResult,
    InterfaceSpec,
    NormalizationResult,
    ParseDiagnostic,
    RunContext,
    SystemAdapter,
)
from crosslayer.core.contracts import BoundaryContract, load_contracts_file
from crosslayer.core.errors import AdapterError
from crosslayer.core.telemetry import NormalizedEvent
from crosslayer.core.units import decimal_seconds_to_ns

HERE = Path(__file__).resolve().parent
SOURCE_SYSTEM = "@@NAME@@"
NAMESPACE = "@@NAME@@"  # attributes are namespaced, e.g. @@NAME@@.latency_us

# TODO: match your log format. Example line:
#   0.000420 worker request.completed session=1 req=1 latency_us=270
LINE = re.compile(r"^(?P<ts>\d+(?:\.\d{1,9})?)\s+(?P<subsystem>[a-z_]+)\s+(?P<event>[a-z0-9_.]+)(?P<rest>.*)$")
FIELD = re.compile(r"([a-z_]+)=(\S+)")
# TODO: fields that identify an entity become correlation ids; the rest become attributes.
ID_FIELDS = {"session", "req"}


class @@CLASS@@(SystemAdapter):
    def describe(self) -> AdapterDescription:
        return AdapterDescription(
            name="@@NAME@@",
            adapter_version="0.1.0",
            system="@@NAME@@",
            system_version=None,  # TODO: report the system's version or build id
            subsystems=("controller", "worker"),  # TODO: your components
            interfaces=(InterfaceSpec("controller_to_worker", "controller", "worker"),),
            description="TODO: one line about the system under test.",
        )

    def capabilities(self) -> frozenset[Capability]:
        return frozenset({Capability.COLLECT, Capability.NORMALIZE})

    def event_catalog(self) -> list[EventSpec]:
        # TODO: keep in sync with what normalize() emits; the generated tests check it.
        return [
            EventSpec("session.start", ("controller",), (), ("session",)),
            EventSpec("session.end", ("controller",), (), ("session",)),
            EventSpec("request.received", ("worker",), (), ("session", "req")),
            EventSpec("request.completed", ("worker",), (f"{NAMESPACE}.latency_us",), ("session", "req")),
        ]

    def contracts(self) -> list[BoundaryContract]:
        return load_contracts_file(HERE / "contracts.yaml")

    def collect(self, ctx: RunContext, execution: ExecutionResult | None) -> list[Artifact]:
        if not ctx.inputs:
            raise AdapterError("list the logs to analyze under 'inputs:' in the experiment")
        artifacts = []
        for source in ctx.inputs:
            target = ctx.raw_dir / source.name
            shutil.copyfile(source, target)
            artifacts.append(Artifact(source.name, target, description="input log"))
        return artifacts

    def normalize(self, ctx: RunContext, artifacts: Sequence[Artifact]) -> NormalizationResult:
        events: list[NormalizedEvent] = []
        diagnostics: list[ParseDiagnostic] = []
        for artifact in artifacts:
            with artifact.path.open(encoding="utf-8") as fh:
                for lineno, raw in enumerate(fh, start=1):
                    line = raw.strip()
                    if not line or line.startswith("#"):
                        continue
                    match = LINE.match(line)
                    if match is None:
                        diagnostics.append(ParseDiagnostic(artifact.name, lineno, f"unrecognized: {line[:80]!r}"))
                        continue
                    ids: dict[str, str] = {}
                    attributes: dict[str, Any] = {}
                    for key, value in FIELD.findall(match["rest"]):
                        if key in ID_FIELDS:
                            ids[key] = value
                        else:
                            attributes[f"{NAMESPACE}.{key}"] = int(value) if value.isdigit() else value
                    try:
                        events.append(NormalizedEvent(
                            run_id=ctx.run_id,
                            event_id=f"{artifact.name}:{lineno}",
                            source_system=SOURCE_SYSTEM,
                            subsystem=match["subsystem"],
                            timestamp_ns=decimal_seconds_to_ns(match["ts"]),
                            event_type=match["event"],
                            correlation_ids=ids,
                            attributes=attributes,
                            raw_artifact_ref=ctx.raw_ref(artifact.name, lineno),
                        ))
                    except ValueError as exc:  # report bad lines, never drop them silently
                        diagnostics.append(ParseDiagnostic(artifact.name, lineno, str(exc)))
        return NormalizationResult(events=events, diagnostics=diagnostics)
